generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  OPERADOR
}

enum StatusPedido {
  ABERTO
  PENDENTE
  FECHADO
  CANCELADO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  login     String   @unique
  senhaHash String
  perfil    Perfil   @default(OPERADOR)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  pedidos Pedido[]
  envios  EnvioCobranca[]

  @@map("usuarios")
}

model Cliente {
  id               Int      @id @default(autoincrement())
  nome             String
  telefoneWhatsapp String
  observacao       String?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())

  pedidos Pedido[]
  envios  EnvioCobranca[]

  @@map("clientes")
}

model Produto {
  id          Int      @id @default(autoincrement())
  nome        String
  precoPadrao Decimal  @db.Decimal(12, 2)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  itens PedidoItem[]

  @@map("produtos")
}

model Pedido {
  id         Int          @id @default(autoincrement())
  clienteId  Int
  usuarioId  Int
  dataPedido DateTime     @default(now())
  status     StatusPedido @default(ABERTO)
  observacao String?
  enviadoEm  DateTime?
  fechadoEm  DateTime?
  envioId    Int?
  criadoEm   DateTime     @default(now())

  cliente Cliente         @relation(fields: [clienteId], references: [id])
  usuario Usuario         @relation(fields: [usuarioId], references: [id])
  envio   EnvioCobranca?  @relation(fields: [envioId], references: [id])
  itens   PedidoItem[]

  @@index([clienteId])
  @@index([dataPedido])
  @@index([status])
  @@map("pedidos")
}

model PedidoItem {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("pedido_itens")
}

model EnvioCobranca {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  usuarioId     Int
  periodoInicio DateTime
  periodoFim    DateTime
  valorTotal    Decimal  @db.Decimal(12, 2)
  criadoEm      DateTime @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  pedidos Pedido[]

  @@map("envios_cobranca")
}

model TentativaLogin {
  id       Int      @id @default(autoincrement())
  login    String
  ip       String
  criadoEm DateTime @default(now())

  @@index([login, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}